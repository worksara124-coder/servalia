---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/mona-sans';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  accent?: string;
  onAccent?: string;
  image?: string;
}
const { title, description, accent = '#e10a0a', onAccent = '#ffffff', image = '/img/atelier-mecanique.webp' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#f4f5f5" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_MA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: 'SERVALIA',
      description: 'Maintenance industrielle, électromécanique, automatismes, usinage de précision et construction métallique.',
      foundingDate: '2018',
      address: { '@type': 'PostalAddress', streetAddress: 'LT Panorama Al Azhar', addressLocality: 'Casablanca', addressCountry: 'MA' },
      url: Astro.site?.toString(),
    })} />
    <ClientRouter fallback="animate" />
  </head>
  <body style={`--ac:${accent};--on:${onAccent}`}>
    <a class="skiplink" href="#contenu">Aller au contenu</a>
    <slot />
    <script>import "../scripts/site.ts";</script>
  </body>
</html>
